typedef (SubscriptionObserverCallback or SubscriptionObserver) ObserverUnion;
typedef (SubscriptionObserverCallback or ObservableInspector) ObservableInspectorUnion;
[
    Exposed=*,
    EnabledBySetting=ObservableEnabled,
    ActiveDOMObject,
    CustomToJSObject,
    GenerateIsReachable=Impl,
    JSCustomMarkFunction
] interface Observable {
    [CallWith=CurrentScriptExecutionContext] constructor((SubscriberCallback or ObservableConfig) producer);
    readonly attribute FrozenArray<SharedObservable>? sharedSources;
    [CallWith=CurrentScriptExecutionContext] undefined subscribe(optional ObserverUnion observer = {}, optional SubscribeOptions options = {});
    [CallWith=CurrentGlobalObject, RaisesException] static Observable from(any value);
    [CallWith=CurrentGlobalObject, RaisesException] SharedObservable share(optional ShareConfig config = {});
    [CallWith=CurrentGlobalObject, RaisesException] Observable takeUntil(any value);
    [CallWith=CurrentScriptExecutionContext] Observable map(MapperCallback mapper);
    [CallWith=CurrentScriptExecutionContext] Observable filter(PredicateCallback predicate);
    [CallWith=CurrentScriptExecutionContext] Observable take(unsigned long long amount);
    [CallWith=CurrentScriptExecutionContext] Observable drop(unsigned long long amount);
    [CallWith=CurrentScriptExecutionContext] Observable flatMap(MapperCallback mapper);
    [CallWith=CurrentScriptExecutionContext] Observable switchMap(MapperCallback mapper);
    [CallWith=CurrentScriptExecutionContext] Observable inspect(optional ObservableInspectorUnion inspectorUnion = {});
    [CallWith=CurrentScriptExecutionContext, ImplementedAs=catchException] Observable catch(ObservableCatchCallback callback);
    [CallWith=CurrentScriptExecutionContext, ImplementedAs=finallyCallback] Observable finally(VoidCallback callback);
};
